#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>

#include <Atom/RPI/Math.azsli>
#include <Atom/Features/ScreenSpace/ScreenSpaceUtil.azsli>

#include "CloudscapeCommon.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // A number from 0 .. 15. Defines the pixel index
    // within each 4x4 block that will be ray marched in this frame. 
    uint m_pixelIndex4x4;
    uint m_historyValid;

    // We write to only one of these two textures every other frame.
    RWTexture2D<float4> m_cloudscapeTexture[2];
    
    Texture2D<float2> m_depthStencilTexture;

    uint GetOutputTextureIndex()
    {
        return (uint)fmod(m_pixelIndex4x4, 2);
    }

    // This helper function calculates the corresponding
    // XY location within a 4x4 block of pixels.
    uint2 GetPixelBlockXY()
    {
        const uint pixelIndex4x4 = GetTransformed4x4PixelIndex(m_pixelIndex4x4);
        const uint rowIdx = pixelIndex4x4 >> 2;
        const uint colIdx = pixelIndex4x4 - (rowIdx << 2);
        return uint2(colIdx, rowIdx);
    }

    uint2 GetRayMarchedPixelLocation(uint2 pixelLoc, uint2 screenDims)
    {
        return min((pixelLoc / 4) * 4 + GetPixelBlockXY(), screenDims - 1);
    }

    bool GetPreviousPixel(uint2 pixelLoc, uint2 screenDims, out float2 previousPixel)
    {
        const float2 uv = (float2(pixelLoc) + 0.5) / float2(screenDims);
        // Clouds are distant sky, so geometry depth must not distort their
        // history at silhouettes. Transform a direction (w=0), never a point
        // reconstructed at reverse-depth zero, which may be at infinity.
        const float4 positionVS = mul(ViewSrg::m_projectionMatrixInverse,
            float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.5, 1.0));
        const float3 directionWS = mul(ViewSrg::m_viewMatrixInverse,
            float4(positionVS.xyz / positionVS.w, 0.0)).xyz;
        const float4 previousClip = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(directionWS, 0.0));
        previousPixel = 0;
        if (previousClip.w <= 0.000001)
        {
            return false;
        }
        const float2 previousUv = previousClip.xy / previousClip.w * float2(0.5, -0.5) + 0.5;
        previousPixel = previousUv * float2(screenDims) - 0.5;
        return all(previousPixel >= 0) && all(previousPixel <= float2(screenDims - 1));
    }

    float4 SampleHistory(uint textureIndex, float2 pixel, uint2 dims)
    {
        const uint2 p0 = uint2(floor(pixel));
        const uint2 p1 = min(p0 + 1, dims - 1);
        const float2 fraction = frac(pixel);
        return lerp(
            lerp(m_cloudscapeTexture[textureIndex][p0],
                 m_cloudscapeTexture[textureIndex][uint2(p1.x, p0.y)], fraction.x),
            lerp(m_cloudscapeTexture[textureIndex][uint2(p0.x, p1.y)],
                 m_cloudscapeTexture[textureIndex][p1], fraction.x), fraction.y);
    }

}


// Unlike CloudscapeCS.azsl, this compute shader is invoked with as many
// threads as the width and height of the image.
// This means the first thing we must do is calculate if for this thread,
// the pixel coordinate is the 1/16 that was actually raymarched by CloudscapeCS.azsl.
// If it was raymarched we return early. For all other 15 pixels we do the actually reprojection
// and copy pixel colors from the previous frame into the current frame.
// Remark about thread_id and pixel location...
// Each Thread is invoked to write to 1 out of 16 pixels (0..15)
// in 4x4 block.
// For example imagine the UAV is of size 1280x720.
// The Dispatch call would be (1280/8, 720/8, 1) = (160, 90, 1)
// But further more, the total required number of Thread Groups should be
// (160/4, 90/4, 1) = (40, 22.5, 1) = (40, 23, 1)
// So, in the end we have to multiply SV_DispatchThreadID.xy * 4 + f 
[numthreads(8, 8, 1)]
void MainCS(uint3 thread_id: SV_DispatchThreadID)
{
    uint2 pixelLoc = thread_id.xy;

    // Do nothing if we are outside the target texture dimensions.
    // This only happens when the render target size is not an exact multiple
    // of 8x8 (Thread Group Size)
    uint2 texDims;
    PassSrg::m_cloudscapeTexture[0].GetDimensions(texDims.x, texDims.y);
    if ((pixelLoc.x >= texDims.x) || (pixelLoc.y >= texDims.y))
    {
        return;
    }

    const uint2 samplePixel = PassSrg::GetRayMarchedPixelLocation(pixelLoc, texDims);
    if (all(pixelLoc == samplePixel))
    {
        return;
    }
    const uint currentIndex = PassSrg::GetOutputTextureIndex();
    const float4 currentSample = PassSrg::m_cloudscapeTexture[currentIndex][samplePixel];
    float2 previousPixel;
    float4 result = currentSample;
    if (PassSrg::m_historyValid != 0 && PassSrg::GetPreviousPixel(pixelLoc, texDims, previousPixel))
    {
        // A bounded history weight follows changing weather and moving clouds;
        // bilinear sampling avoids nearest-neighbour trails during camera motion.
        result = lerp(currentSample, PassSrg::SampleHistory(1 - currentIndex, previousPixel, texDims), 0.9);
    }
    PassSrg::m_cloudscapeTexture[currentIndex][pixelLoc] = result;
}
